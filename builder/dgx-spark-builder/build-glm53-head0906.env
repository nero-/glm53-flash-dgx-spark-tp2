# build-glm53-head0906.env -- GLM-5.3-Flash: EXPERIMENTAL head-20260906 line.
#
# This is the A/B probe of the experimental tips behind glm53rankenv.txt
# (the head-20260906 snapshot description: "Luke's Spark decode defaults,
# the b12x loader, #667/#669 cache and spec-decode fixes"). It is built
# from the same qualified toolchain as build-glm53-devspark.env; ONLY the
# two upstream pins (and the image tag) move. The devspark profile and the
# devspark image on r0/r1 are untouched -- the rollback anchor stays intact.
#
# Pin provenance (verified 2026-09-06 via GitHub API):
# - vLLM local-inference-lab/vllm @ 2a979314 = head of branch
#   dev/jovian-judgement at the time of staging. Subject: "Fix loader-owned
#   allocation for the GLM Flash MTP projection" (touches
#   vllm/models/glm5next/nvidia/mtp.py). Sits on the same line as the
#   devspark pin (858b4912: #667 gdn spec-decode fast path, #669 aligned
#   hybrid cache reuse + endpoint checkpoints, #672 Mamba state in
#   recurrent block units, b12x-loader integration) plus the new
#   MTP-projection allocation work that glm53rankenv.txt's decode-default
#   quartet (VLLM_MXFP8_LM_HEAD et al.) is gated on.
# - b12x local-inference-lab/b12x @ 3eb57add = "Test GLM Flash MTP
#   projection allocation and direct loading" (tests/loader/test_vllm.py).
#   NOT a branch head: it is an ancestor of master (7 commits behind
#   master's tip as of staging). A full clone of master contains it, so the
#   wrapper's checkout-ref-then-verify-commit flow resolves with
#   B12X_REF = B12X_PIN = the sha, exactly like the r22b/devspark builds.
# - Pair commits authored ~1 minute apart on 2026-09-06 22:31/22:32 -- a
#   matched vLLM+b12x cut, not two independent tips.
# - Serving flags ratified for this line live in env/rank-*-mtp3-spark.env /
#   df-spark.env (the "head-0906" block) and in pairctl's injected extras:
#   LOAD_FORMAT=b12x available (templates still load instanttensor;
#   switching is one edit + VLLM_PLUGINS=b12x_loader), --mamba-cache-mode
#   align (launcher default), --kda-prefill-backend b12x +
#   --recurrent-checkpoint-policy request_boundaries (pairctl-injected).

IMAGE_REPO=local/vllm
IMAGE_TAG=glm53-flash-nvfp4-head0906

# The toolchain is byte-identical to the devspark profile, so share its base
# stages (the wrapper derives per-profile base tags otherwise, which would
# force a full cold build). Only the downstream vllm/b12x stages rebuild:
# warm ~15 min instead of ~70.
SYSTEM_BASE_IMAGE=local/vllm:glm53-flash-nvfp4-devspark-system-base
BUILD_BASE_IMAGE_TAG=local/vllm:glm53-flash-nvfp4-devspark-build-base


# ------------------------------------------------------------------ wrapper
LOGGING=1
PIN_PREFLIGHT=1


# ------------------------------------------------------------------ profile
PROFILE_NAME=glm53-head0906
VLLM_REQUIRED_LAUNCHERS=serve-glm53-flash-nvfp4.sh


# ------------------------------------------------------------------ sources
VLLM_REPO=https://github.com/local-inference-lab/vllm.git
VLLM_PIN=2a979314dc97b03173a0a76fc15664ec924db32b
B12X_REPO=https://github.com/local-inference-lab/b12x.git
B12X_PIN=3eb57addb57b86360e9164467a4459ab964bfcac


# ---------------------------------------------------------------- toolchain
# Identical to the qualified r22b/devspark combination -- only the two
# upstream pins above move in this experiment.
NCCL_REPO=https://github.com/local-inference-lab/nccl-canonical.git
NCCL_REF=canonical/cu132-nccl2304-amd-noxml
NCCL_COMMIT=dfab7c1ace32da250ba97757879429c341b7bcf9
FLASHINFER_REPO=https://github.com/voipmonitor/flashinfer.git
FLASHINFER_REF=integration/main-pr4393-pcie-ipc-qualified-20260807
FLASHINFER_COMMIT=1ac6942776b383c6b03c7a5805a22e72a3e3349f
FLASHINFER_BUILD_CUBIN=0
TORCH_VERSION=2.13.0+cu132
TORCHVISION_VERSION=0.28.0+cu132
TORCH_BUNDLED_NCCL_VERSION=2.29.7
CUTLASS_REF=e6233cbac5d7c7a865c19c91cd684ceece19513c
CUTLASS_COMMIT=e6233cbac5d7c7a865c19c91cd684ceece19513c
CUTLASS_DSL_VERSION=4.6.2
TILELANG_VERSION=0.1.12
TOKENSPEED_MLA_VERSION=0.1.8
TVM_FFI_VERSION=0.1.11
QUACK_KERNELS_SPEC=quack-kernels==0.6.4
FASTSAFETENSORS_SPEC=fastsafetensors>=0.3.3
HUMMING_KERNELS_SPEC=humming-kernels[cu13]==0.1.12
XGRAMMAR_REF=v0.2.5
XGRAMMAR_COMMIT=2ea71da4ccb997a06928c9fb69b99f330da56697
XGRAMMAR_VERSION=0.2.5
XGRAMMAR_TRANSFORMERS5_COMPAT=1
DEEPGEMM_REF=a6b593d2826719dcf4892609af7b84ee23aaf32a
DEEPGEMM_COMMIT=a6b593d2826719dcf4892609af7b84ee23aaf32a
INSTANTTENSOR_REPO=https://github.com/voipmonitor/InstantTensor.git
INSTANTTENSOR_REF=49b4010afc1cae0441e71fe0b0bffc24fa05e932
INSTANTTENSOR_COMMIT=49b4010afc1cae0441e71fe0b0bffc24fa05e932
VLLM_RUNTIME_EXTRA_PACKAGES=nvtx==0.2.15 nccl4py==0.3.1


# ---------------------------------------------------------------- resources
MAX_JOBS=20
VLLM_MAX_JOBS=20
NVCC_THREADS=1
VLLM_NVCC_THREADS=1
PIN_SOURCE_COMMITS=1


# ------------------------------------------------------------ patch toggles
PATCH_GPU_ARCH=auto
PATCH_HOST_ARCH=auto
PATCH_PCIE_ENV=auto
PATCH_PIPCHECK_WHEELTAG=auto
PATCH_VLLM_REQ_MARKERS=auto
PATCH_EXLLAMAV3_AVX=auto
