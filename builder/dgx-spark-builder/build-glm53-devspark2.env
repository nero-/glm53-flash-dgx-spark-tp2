# build-glm53-devspark2.env -- GLM-5.3-Flash: devspark line re-pinned (2026-09-07).
#
# Same line as build-glm53-devspark.env, toolchain unchanged; the two source
# pins move to the heads that fix what blocked the b12x loader on the first
# devspark boot (that boot fell back to LOAD_FORMAT=instanttensor):
# - vLLM dev/jovian-judgement @ 2a979314 (head 2026-09-07): adds on top of the
#   old 858b4912 pin: loader-owned GLM/KDA checkpoint weights (7d66922a),
#   b12x loading for full GLM + DeepSeek (6daf0036), instruction checkpoints
#   for user-required chat templates (23771aab), #674 specialized scalar
#   indices in checkpoint restore, #675 leading instruction checkpoint retain,
#   #683 admit exact checkpoint hits during active decode, and
#   2a979314 "Fix loader-owned allocation for the GLM Flash MTP projection"
#   (eh_proj was unmarked -> ordinary CUDA storage -> b12x rejected the MTP
#   checkpoint copy). Upstream validated TP2/MTP boots with b12x on GB10.
# - b12x master @ f46fee91: strided TP checkpoint slice loading (eb246263, the
#   companion), MTP projection allocation test (3eb57add), GLM-5.3 MoE M1 FC2
#   row-pair overlap, MXFP8 gemm fill-eliding, #302 W4A8 profiling-oracle fix,
#   #246 "make TP2 graph peer-push generation-safe" (stale tail records could
#   be consumed at larger replay shapes).
#
# Loader docs at this pin: `VLLM_PLUGINS=b12x_loader vllm serve ... --load-format b12x`;
# write-combined pinned storage is unconditional, no allocation option.
# Serving flags for this line (rank envs + pairctl):
#   LOAD_FORMAT=b12x, VLLM_PLUGINS=b12x_loader,
#   --recurrent-checkpoint-policy request_boundaries (pairctl EXTRA),
#   --kda-prefill-backend b12x (pairctl EXTRA),
#   MTP experts: MXFP8 -> humming default (nvfp4 quant) / marlin (spark quant).

IMAGE_REPO=local/vllm
IMAGE_TAG=glm53-flash-nvfp4-devspark2


# ------------------------------------------------------------------ wrapper
LOGGING=1
PIN_PREFLIGHT=1


# ------------------------------------------------------------------ profile
PROFILE_NAME=glm53-devspark2
VLLM_REQUIRED_LAUNCHERS=serve-glm53-flash-nvfp4.sh


# ------------------------------------------------------------------ sources
VLLM_REPO=https://github.com/local-inference-lab/vllm.git
VLLM_PIN=2a979314dc97b03173a0a76fc15664ec924db32b
B12X_REPO=https://github.com/local-inference-lab/b12x.git
B12X_PIN=f46fee91374ee91ac4053cdf77287147e73314c1


# ---------------------------------------------------------------- toolchain
# Identical to the qualified r22b combination (unchanged since devspark).
NCCL_REPO=https://github.com/local-inference-lab/nccl-canonical.git
NCCL_REF=canonical/cu132-nccl2304-amd-noxml
NCCL_COMMIT=dfab7c1ace32da250ba97757879429c341b7bcf9
FLASHINFER_REPO=https://github.com/voipmonitor/flashinfer.git
FLASHINFER_REF=integration/main-pr4393-pcie-ipc-qualified-20260807
FLASHINFER_COMMIT=1ac6942776b383c6b03c7a5805a22e72a3e3349f
FLASHINFER_BUILD_CUBIN=0
TORCH_VERSION=2.13.0+cu132
TORCHVISION_VERSION=0.28.0+cu132
TORCH_BUNDLED_NCCL_VERSION=2.29.7
CUTLASS_REF=e6233cbac5d7c7a865c19c91cd684ceece19513c
CUTLASS_COMMIT=e6233cbac5d7c7a865c19c91cd684ceece19513c
CUTLASS_DSL_VERSION=4.6.2
TILELANG_VERSION=0.1.12
TOKENSPEED_MLA_VERSION=0.1.8
TVM_FFI_VERSION=0.1.11
QUACK_KERNELS_SPEC=quack-kernels==0.6.4
FASTSAFETENSORS_SPEC=fastsafetensors>=0.3.3
HUMMING_KERNELS_SPEC=humming-kernels[cu13]==0.1.12
XGRAMMAR_REF=v0.2.5
XGRAMMAR_COMMIT=2ea71da4ccb997a06928c9fb69b99f330da56697
XGRAMMAR_VERSION=0.2.5
XGRAMMAR_TRANSFORMERS5_COMPAT=1
DEEPGEMM_REF=a6b593d2826719dcf4892609af7b84ee23aaf32a
DEEPGEMM_COMMIT=a6b593d2826719dcf4892609af7b84ee23aaf32a
INSTANTTENSOR_REPO=https://github.com/voipmonitor/InstantTensor.git
INSTANTTENSOR_REF=49b4010afc1cae0441e71fe0b0bffc24fa05e932
INSTANTTENSOR_COMMIT=49b4010afc1cae0441e71fe0b0bffc24fa05e932
VLLM_RUNTIME_EXTRA_PACKAGES=nvtx==0.2.15 nccl4py==0.3.1


# ---------------------------------------------------------------- resources
MAX_JOBS=20
VLLM_MAX_JOBS=20
NVCC_THREADS=1
VLLM_NVCC_THREADS=1
PIN_SOURCE_COMMITS=1


# ------------------------------------------------------------ patch toggles
PATCH_GPU_ARCH=auto
PATCH_HOST_ARCH=auto
PATCH_PCIE_ENV=auto
PATCH_PIPCHECK_WHEELTAG=auto
PATCH_VLLM_REQ_MARKERS=auto
PATCH_EXLLAMAV3_AVX=auto
