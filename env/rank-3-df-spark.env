# rank-3-df-spark.env -- gx10-r3 (worker, rank 1, cluster 2) --
# GLM-5.3-Flash NVFP4-Spark quant, DFlash2@7 draft (CC BY-NC-ND).
# Image local/vllm:glm53-flash-nvfp4-head0906-managed = vllm dev/jovian-judgement @ 2a979314
# + b12x @ 3eb57add + the one-line -managed loader patch. Cluster 2 runs the SAME
# image and the same four profiles as cluster 1 (devc646 line retired 2026-09-07).
# b12x checkpoint loader (LOAD_FORMAT=b12x + VLLM_PLUGINS=b12x_loader; boots with MTP).
# Geometry 2048/256 + match 256. Batch 8192, KV pin 12.5 GiB (13421772800 bytes), ctx 256k, MM 4 img / 0 vid.
# Template is IP-scrubbed -- the live host file is ground truth.

# 1. NODE IDENTITY
NODE_RANK=1
MASTER_ADDR=<c2-r0-fabric-ip>
VLLM_HOST_IP=<c2-r1-fabric-ip>

# 2. HOST PATHS
MODEL_HOST_PATH=/home/nero/builds/glm53-flash-dgx-spark-tp2/models/glm53-flash-nvfp4-spark
DFLASH_MODEL_HOST_PATH=/home/nero/builds/glm53-flash-dgx-spark-tp2/models/glm53-flash-dflash2
DFLASH_WEIGHTS_SHA256=c033e03d47c7d5608596c8fc4e9336a1fe086eb781c08fe031be2bdea1614e58
CACHE_HOST_PATH=/home/nero/builds/glm53-flash-dgx-spark-tp2/cache
SERVING_IMAGE=local/vllm:glm53-flash-nvfp4-head0906-managed

# 3. SERVING
API_PORT=8000
MASTER_PORT=29500
SERVED_MODEL_NAME=zai-org/GLM-5.3-Flash
SPECULATOR=dflash2
NUM_SPECULATIVE_TOKENS=7
MAX_MODEL_LEN=262144
MM_IMAGES=4
MM_VIDEOS=0
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
MAX_CUDAGRAPH_CAPTURE_SIZE=96
PREFILL_SCHEDULE_INTERVAL=8
CUDAGRAPH_MODE=FULL_AND_PIECEWISE
COMPILATION_LEVEL=2
LOAD_FORMAT=b12x
VLLM_PLUGINS=b12x_loader
VLLM_GLM53_SPLIT_TARGET_BLOCK_SIZE=2048
VLLM_GLM53_SPLIT_MAMBA_BLOCK_SIZE=256


BLOCK_SIZE=2048

PREFIX_MATCH_UNIT=256

KDA_PREFILL_BACKEND=flashkda
B12X_POLICY_MODE=auto

VLLM_GDN_DECODE_KERNEL=b12x

MM_PROCESSOR_CACHE_GB=0

MM_ENCODER_TP_MODE=data

# head-0906 block (LM-head decode defaults, GDN kernel, RoCEnante, staging bound)
VLLM_MXFP8_LM_HEAD=1

# head-0906 block (LM-head decode defaults, GDN kernel, RoCEnante, staging bound)
VLLM_LM_HEAD_A16=1

# head-0906 block (LM-head decode defaults, GDN kernel, RoCEnante, staging bound)
VLLM_MTP_NVFP4_LM_HEAD=1

# head-0906 block (LM-head decode defaults, GDN kernel, RoCEnante, staging bound)
VLLM_GDN_SPEC_DECODE_METADATA_FASTPATH=1

# head-0906 block (LM-head decode defaults, GDN kernel, RoCEnante, staging bound)
GDN_DECODE_KERNEL=b12x

# head-0906 block (LM-head decode defaults, GDN kernel, RoCEnante, staging bound)
VLLM_ENABLE_ROCE_ALLREDUCE=1

# head-0906 block (LM-head decode defaults, GDN kernel, RoCEnante, staging bound)
VLLM_ROCE_ALLREDUCE_MAX_SIZE=2097152

# head-0906 block (LM-head decode defaults, GDN kernel, RoCEnante, staging bound)
VLLM_ROCE_ALLGATHER_MAX_SIZE=16777216

# head-0906 block (LM-head decode defaults, GDN kernel, RoCEnante, staging bound)
B12X_ROCE_CACHE_DIR=/cache/jit/b12x-roce

# head-0906 block (LM-head decode defaults, GDN kernel, RoCEnante, staging bound)
INSTANTTENSOR_BUFFER_SIZE=1342177280
# 4. MEMORY
GPU_MEMORY_UTILIZATION=0.85
KV_CACHE_MEMORY_BYTES=13421772800
KV_CACHE_DTYPE=fp8

# 5. RUNTIME
CUTE_DSL_ARCH=sm_121a
FLASHINFER_CUDA_ARCH_LIST=12.1f
VLLM_B12X_MOE_FP4_FORCE_A16=0
LINEAR_BACKEND=b12x
LANGUAGE_MODEL_ONLY=0
VLLM_ENABLE_PCIE_ALLREDUCE=0
VLLM_WORKER_MULTIPROC_METHOD=spawn
SAFETENSORS_FAST_GPU=1
INSTANTTENSOR_BACKEND=BUFFERED
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_DEVICE_MAX_CONNECTIONS=32
OMP_NUM_THREADS=2
HF_HOME=/root/.cache/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
VLLM_NO_USAGE_STATS=1
CONTAINER_RUNTIME=docker

# 6. LOADER
LD_PRELOAD=/usr/local/cuda/compat/libcuda.so.1:/opt/libnccl-local-inference.so.2.30.4
VLLM_NCCL_SO_PATH=/opt/libnccl-local-inference.so.2.30.4
NCCL_LOCAL_INFERENCE_PATH=/opt/libnccl-local-inference.so.2.30.4
NCCL_PR2127_PATH=/opt/libnccl-local-inference.so.2.30.4
TORCH_USE_RTLD_GLOBAL=1

# 7. FABRIC -- gx10-r1: v2 GID index 4 on rocep1s0f1 (re-check after every reboot)
NCCL_SOCKET_IFNAME=enp1s0f1np1
GLOO_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_HCA=rocep1s0f1
NCCL_IB_GID_INDEX=3
NCCL_NET=IB
NCCL_NET_PLUGIN=none
NCCL_IB_DISABLE=0
NCCL_IB_SUBNET_AWARE_ROUTING=0
NCCL_IB_MERGE_NICS=0
NCCL_PROTO=LL,LL128,Simple
NCCL_P2P_LEVEL=SYS
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN

# spark quant: NVFP4 MTP experts -> marlin (r21 doc alignment, SM121 loop fix)
