# rank-1-df.env -- gx10-r1 (headless worker) -- jj-master image, DFlash2 option
# dflash@7, vision 4/1, batch 4096, split pages 4096/4096, KV pin 9 GiB (~534k tokens), 256k ctx.

# 1. NODE IDENTITY
NODE_RANK=1
MASTER_ADDR=<c1-r0-fabric-ip>
VLLM_HOST_IP=<c1-r1-fabric-ip>

# 2. HOST PATHS
MODEL_HOST_PATH=/home/nero/builds/glm53-flash-dgx-spark-tp2/models/glm53-flash-nvfp4-spark
DFLASH_MODEL_HOST_PATH=/home/nero/builds/glm53-flash-dgx-spark-tp2/models/glm53-flash-dflash2
DFLASH_WEIGHTS_SHA256=c033e03d47c7d5608596c8fc4e9336a1fe086eb781c08fe031be2bdea1614e58
CACHE_HOST_PATH=/home/nero/builds/glm53-flash-dgx-spark-tp2/cache
SERVING_IMAGE=local/vllm:glm53-flash-nvfp4-devspark

# 3. SERVING
API_PORT=8000
MASTER_PORT=29500
SERVED_MODEL_NAME=zai-org/GLM-5.3-Flash
SPECULATOR=dflash2
NUM_SPECULATIVE_TOKENS=7
MAX_MODEL_LEN=262144
MM_IMAGES=4
MM_VIDEOS=0
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=4096
MAX_CUDAGRAPH_CAPTURE_SIZE=96
PREFILL_SCHEDULE_INTERVAL=8
CUDAGRAPH_MODE=FULL_AND_PIECEWISE
LOAD_FORMAT=instanttensor
VLLM_GLM53_SPLIT_TARGET_BLOCK_SIZE=4096
VLLM_GLM53_SPLIT_MAMBA_BLOCK_SIZE=4096

# 4. MEMORY
GPU_MEMORY_UTILIZATION=0.85
KV_CACHE_MEMORY_BYTES=13421772800
KV_CACHE_DTYPE=fp8

# 5. RUNTIME
CUTE_DSL_ARCH=sm_121a
FLASHINFER_CUDA_ARCH_LIST=12.1f
VLLM_B12X_MOE_FP4_FORCE_A16=0
LINEAR_BACKEND=b12x
LANGUAGE_MODEL_ONLY=0
VLLM_ENABLE_PCIE_ALLREDUCE=0
VLLM_WORKER_MULTIPROC_METHOD=spawn
SAFETENSORS_FAST_GPU=1
INSTANTTENSOR_BACKEND=BUFFERED
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_DEVICE_MAX_CONNECTIONS=32
OMP_NUM_THREADS=2
HF_HOME=/root/.cache/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
VLLM_NO_USAGE_STATS=1
CONTAINER_RUNTIME=docker

# 6. LOADER
LD_PRELOAD=/usr/local/cuda/compat/libcuda.so.1:/opt/libnccl-local-inference.so.2.30.4
VLLM_NCCL_SO_PATH=/opt/libnccl-local-inference.so.2.30.4
NCCL_LOCAL_INFERENCE_PATH=/opt/libnccl-local-inference.so.2.30.4
NCCL_PR2127_PATH=/opt/libnccl-local-inference.so.2.30.4
TORCH_USE_RTLD_GLOBAL=1

# 7. FABRIC -- gx10-r1: v2 GID index 4 on rocep1s0f1 (re-check after every reboot)
NCCL_SOCKET_IFNAME=enp1s0f1np1
GLOO_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_HCA=rocep1s0f1
NCCL_IB_GID_INDEX=3
NCCL_NET=IB
NCCL_NET_PLUGIN=none
NCCL_IB_DISABLE=0
NCCL_IB_SUBNET_AWARE_ROUTING=0
NCCL_IB_MERGE_NICS=0
NCCL_PROTO=LL,LL128,Simple
NCCL_P2P_LEVEL=SYS
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN

# spark quant: NVFP4 MTP experts -> marlin (r21 doc alignment, SM121 loop fix)
MTP_MOE_BACKEND=marlin
