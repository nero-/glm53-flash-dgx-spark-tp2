# rank-2-dflash2.env -- gx10-r2 (API head, rank 0 of cluster gx10-r2-r3) --
# DFlash2@7 coding profile, multimodal (images 4 + video 1).
# Image: glm53-flash-nvfp4-devc646 = upstream dev/jovian-judgement
# (a8c796f3, includes #649 one-exchange top-k + LM-head/metadata reuse) +
# PR #646 (fine-grained prefix-cache hits; 2048/256 split geometry).
# Geometry: 2048 target / 256 recurrent / 256 match (PR #646 measured set).
# KV pin: see KV pin note -- calibrate with KV_CACHE_MEMORY_BYTES empty on the
# first boot, then pin for a ~118.5-119 GiB steady node (headroom vs the
# ~121.5 GiB host OOM-killer cliff).

# 1. NODE IDENTITY (cluster 2 -- gx10-r2-r3)
NODE_RANK=0
MASTER_ADDR=<c2-r0-fabric-ip>
VLLM_HOST_IP=<c2-r0-fabric-ip>

# 2. HOST PATHS
MODEL_HOST_PATH=/home/nero/builds/glm53-flash-dgx-spark-tp2/models/glm53-flash-nvfp4
DFLASH_MODEL_HOST_PATH=/home/nero/builds/glm53-flash-dgx-spark-tp2/models/glm53-flash-dflash2
DFLASH_WEIGHTS_SHA256=c033e03d47c7d5608596c8fc4e9336a1fe086eb781c08fe031be2bdea1614e58
CACHE_HOST_PATH=/home/nero/builds/glm53-flash-dgx-spark-tp2/cache
SERVING_IMAGE=local/vllm:glm53-flash-nvfp4-devspark

# 3. SERVING
API_PORT=8000
MASTER_PORT=29500
SERVED_MODEL_NAME=zai-org/GLM-5.3-Flash
SPECULATOR=dflash2
NUM_SPECULATIVE_TOKENS=7
ADAPTIVE_SPECULATIVE_TOKENS=0
ADAPTIVE_SPECULATIVE_TOKENS_INITIAL=3
ADAPTIVE_SPECULATIVE_TOKENS_WINDOW=32
MAX_MODEL_LEN=262144
MM_IMAGES=4
MM_VIDEOS=1
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=4096
MAX_CUDAGRAPH_CAPTURE_SIZE=96
PREFILL_SCHEDULE_INTERVAL=8
CUDAGRAPH_MODE=FULL_AND_PIECEWISE
LOAD_FORMAT=instanttensor

# 3b. r25+/PR-646 cache geometry + KDA backend
BLOCK_SIZE=2048
PREFIX_MATCH_UNIT=256
KDA_PREFILL_BACKEND=b12x

# 4. MEMORY
GPU_MEMORY_UTILIZATION=0.85
KV_CACHE_MEMORY_BYTES=4831838208
KV_CACHE_DTYPE=fp8

# 5. RUNTIME (r22-qualified values; NCCL/OMP kept at the r22 baseline for
# apples-to-apples benchmarking vs the r22b runs)
CUTE_DSL_ARCH=sm_121a
FLASHINFER_CUDA_ARCH_LIST=12.1f
VLLM_B12X_MOE_FP4_FORCE_A16=0
LINEAR_BACKEND=b12x
LANGUAGE_MODEL_ONLY=0
VLLM_ENABLE_PCIE_ALLREDUCE=0
VLLM_WORKER_MULTIPROC_METHOD=spawn
SAFETENSORS_FAST_GPU=1
INSTANTTENSOR_BACKEND=BUFFERED
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_DEVICE_MAX_CONNECTIONS=32
OMP_NUM_THREADS=2
HF_HOME=/root/.cache/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
VLLM_NO_USAGE_STATS=1
CONTAINER_RUNTIME=docker

# 6. LOADER
LD_PRELOAD=/usr/local/cuda/compat/libcuda.so.1:/opt/libnccl-local-inference.so.2.30.4
VLLM_NCCL_SO_PATH=/opt/libnccl-local-inference.so.2.30.4
NCCL_LOCAL_INFERENCE_PATH=/opt/libnccl-local-inference.so.2.30.4
NCCL_PR2127_PATH=/opt/libnccl-local-inference.so.2.30.4
TORCH_USE_RTLD_GLOBAL=1

# 7. FABRIC -- cluster 2: <c2-fabric-subnet> rail, rocep1s0f1, v2 GID index 3
# (live-verified 2026-09-05 on r2/r3; pairctl re-checks + auto-fixes)
NCCL_SOCKET_IFNAME=enp1s0f1np1
GLOO_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_HCA=rocep1s0f1
NCCL_IB_GID_INDEX=3
NCCL_NET=IB
NCCL_NET_PLUGIN=none
NCCL_IB_DISABLE=0
NCCL_IB_SUBNET_AWARE_ROUTING=0
NCCL_IB_MERGE_NICS=0
NCCL_PROTO=LL,LL128,Simple
NCCL_P2P_LEVEL=SYS
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN

# r21 doc alignment: MTP experts use Marlin (SM121 loop fix)
